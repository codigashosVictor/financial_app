SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
SECRET_KEY=una-clave-secreta-larga-y-random-aqui

# Push notifications. Optional unless you enable browser push alerts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# Comma-separated origins allowed to call the app.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Secret shared with the external scheduler that calls POST /cron/send-alerts.
# Leave empty to keep the cron endpoint disabled.
CRON_SECRET=
